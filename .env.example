# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB)
# ------------------------------------------------------------------------------
# MongoDB connection URI (Local or MongoDB Atlas)
# Example local: mongodb://localhost:27017/doinikjamunarkantho
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/doinikjamunarkantho?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/doinikjamunarkantho

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JWT tokens (Admin sessions & previews).
# Generate using: openssl rand -base64 32 or node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your_jwt_auth_secret_minimum_32_characters_here

# ------------------------------------------------------------------------------
# 3. INITIAL ADMIN SEEDING CREDENTIALS
# ------------------------------------------------------------------------------
# Read by `npm run seed:admin` and `app/api/admin/login/route.ts`
ADMIN_NAME="Super Admin"
ADMIN_USER=admin
ADMIN_EMAIL=admin@doinikjamunarkantho.com
ADMIN_PASSWORD=admin@123

# ------------------------------------------------------------------------------
# 4. SITE ORIGIN / CANONICAL URL
# ------------------------------------------------------------------------------
# Base URL for canonical links, sitemaps, and OpenGraph metadata
BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. CLOUDINARY (Media & Image Uploads)
# ------------------------------------------------------------------------------
# Cloudinary credentials for handling article images, ads, and author avatars
CLOUDINARY_CLOUD_NAME=eesshklj
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=eesshklj
CLOUDINARY_API_KEY=753453721251931
CLOUDINARY_API_SECRET=4GF5lJn4X7_lkjLk27GsX6DGx4Q

# Optional: Full Cloudinary URL format (alternative to separate keys)
# CLOUDINARY_URL=cloudinary://753453721251931:4GF5lJn4X7_lkjLk27GsX6DGx4Q@eesshklj

# ------------------------------------------------------------------------------
# 6. CRON / AUTOMATION SECRET
# ------------------------------------------------------------------------------
# Bearer token or URL secret for triggering scheduled article publishing (/api/cron/publish-scheduled)
CRON_SECRET=jamuna_cron_secret_token_12345
